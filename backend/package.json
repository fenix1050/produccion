{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --experimental-test-module-mocks --test src/**/*.test.js",
    "verify:migrations": "node scripts/verificar-numeracion-migraciones.js",
    "test:migrations:pf3": "node --test migrations/069_propuestas_formales_borradores.test.js migrations/071_propuestas_formales_emision_mrc.test.js migrations/072_revoke_pf3_rpc_browser_roles.test.js migrations/073_prevenir_emision_duplicada_propuesta_formal_mrc.test.js migrations/074_pf3_service_role_acl.test.js",
    "e2e:install:chromium": "playwright install chromium",
    "e2e:install:chromium:ci": "playwright install --with-deps chromium",
    "e2e:install:puppeteer": "puppeteer browsers install chrome",
    "test:e2e:smoke": "node --experimental-test-module-mocks ../e2e/support/test-system.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "puppeteer": "^25.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
