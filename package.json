{
  "name": "cotizador-tajy",
  "private": true,
  "description": "Sistema de cotizaciones multi-ramo de Aseguradora Tajy",
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=backend",
    "start": "npm start --workspace=backend",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm test --workspace=backend",
    "check": "npm run format:check && npm run lint && npm test --workspace=backend",
    "prepare": "husky"
  },
  "allowScripts": {
    "puppeteer@25.6.0": true
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "uuid": "^11.1.1"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml,html,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6"
  }
}
